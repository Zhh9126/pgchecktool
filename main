# 修复docx打包问题
def fix_docx_template_path():
    """修复docx库模板路径问题"""
    try:
        if getattr(sys, 'frozen', False):
            base_path = os.path.dirname(sys.executable)
        else:
            base_path = os.path.dirname(os.path.abspath(__file__))
        
        docx_template_dir = os.path.join(base_path, 'docx_templates')
        os.makedirs(docx_template_dir, exist_ok=True)
        
        return True
    except:
        return False

# 初始化修复
fix_docx_template_path()

